<div class="user-card">
  <div class="user-infos">
    <%= link_to user_path(user), class: "user-info" do %>
      <%= user_avatar(user, class_name: "user-avatar") %>
      <div class="user-details">
        <h3 class="user-name">
          <%= user.name.presence || user.email %>
        </h3>
      </div>
    <% end %>
    <div class="user-stats">
      <span>
        <%= user.posts.count %> posts
      </span>
      <% if user == current_user %>
        <%= link_to users_path(filter: "followers"), class: "follow-list" do %>
          <%= user.followers.count %> followers
        <% end %>
        <%= link_to users_path(filter: "following"), class: "follow-list" do %>
          <%= user.following.count %> following
        <% end %>
      <% else %>
        <span>
          <%= user.followers.count %> followers
        </span>
        <span>
          <%= user.following.count %> following
        </span>
      <% end %>
    </div>
  </div>
  <div id="follow_button_<%= user.id %>">
    <%= follow_button(user, params[:filter]) %>
  </div>
  <% if local_assigns[:show_bio] %>
    <div class="profile-bio">
      <%= user.bio.nil? ? "No bio yet" : user.bio %>
    </div>
  <% end %>
</div>