<div class="post-card">
  <div class="post-header">
    <%= link_to user_path(post.user), class: "post-info" do %>
      <%= user_avatar(post.user, class_name:"post-avatar") %>
      <h3>
        <%= post.user.name.presence || post.user.email %>
      </h3>
      <span>
        <%= post.updated_at.strftime("%d/%m/%Y %H:%M") %>
      </span>
    <% end %>
    <% if current_user==post.user %>
      <div class="post-options" data-controller="dropdown">
        <button class="options-btn" data-action="click->dropdown#toggle">
          <%= image_tag "dots.svg", alt: "Options" %>
        </button>
        <div data-dropdown-target="menu" class="dropdown-menu hidden">
          <%= link_to "Edit", edit_post_path(post) %>
          <%= button_to "Delete", post_path(post),method: :delete, data: { turbo_confirm: "Delete this post?" }%>
        </div>
      </div>
    <% end %>
  </div>
  <p>
    <h1><%= post.title %></h1>
    <%= post.body %>
  </p>
  <% if post.images.attached? %>
    <div class="post-images">
      <% post.images.each_with_index do |image, index| %>
        <% if post.images.count % 2 == 1 && index == post.images.count - 1 %>
          <%= image_tag image, class: "span-image" %>
        <% else %>
          <%= image_tag image %>
        <% end %>
      <% end %>
    </div>
  <% end %>
  <div data-controller="comments" class="post-footer-cotainer">
    <div class="post-footer">
      <%= render "shared/likes", post: post %>
      <button
          class="comment-button"
          data-action="click->comments#toggle">
        <%= image_tag "comment.svg", 
        data: { 
        comments_target: "icon", 
        outline_src: asset_path("comment.svg"), 
        fill_src: asset_path("comment-fill.svg") 
        }, 
        class: "comment-icon" %>
        <span id="comments_count_<%= post.id %>">
          <%= post.comments.count %>
        </span>
      </button>
    </div>
    <%= render "shared/comments", post: post %>
  </div>
</div>