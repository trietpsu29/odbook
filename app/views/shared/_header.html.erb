<header class="header">
  <nav class="nav">
    <%= link_to "OdBook", posts_path, class: "nav-logo" %>
    <div class="nav-links">
      <%= link_to users_path, class: "nav-link" do %>
        <%= image_tag "community.svg", alt: "Community" %>
        <span>Community</span>
      <% end %>
      <%= link_to user_path(current_user), class: "nav-link" do %>
        <%= user_avatar(current_user) %>
        <span>Profile</span>
      <% end %>
    </div>
    <%= button_to destroy_user_session_path,
          method: :delete,
          class: "nav-logout" do %>
      <%= image_tag "logout.svg", alt: "Logout" %>
      <span>Log out</span>
    <% end %>
  </nav>
</header>