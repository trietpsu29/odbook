<% if user.errors.any? %>
  <%= turbo_stream.update "flash-container" do %>
    <script>
      alert("<%= j flash[:alert] %>");
    </script>
  <% end %>
<% else %>
  <%= turbo_stream.replace "follow_button_#{user.id}" do %>
    <div id="follow_button_<%= user.id %>">
      <%= follow_button(user) %>
    </div>
  <% end %>
<% end %>