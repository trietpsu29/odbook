<div class="dropdown-options" data-controller="dropdown">
  <button class="dropdown-btn" data-action="click->dropdown#toggle">
    <%= image_tag button_icon, alt: button_alt %>
  </button>
  <div data-dropdown-target="menu" class="dropdown-menu hidden">
    <% options.each do |option| %>
      <% if option[:method] == :delete %>
        <%= button_to option[:name],
            option[:path],
            method: :delete,
            class: "dropdown-btn",
            data: { turbo_confirm: "Delete this post?" } %>
      <% else %>
        <%= link_to option[:name],
            option[:path],
            data: option[:data] %>
      <% end %>
    <% end %>
  </div>
</div>