<div class="devise-container">
  <div class="devise-card">
    <h2>Forgot your password?</h2>
    <%= form_for(resource,
          as: resource_name,
          url: password_path(resource_name),
          html: { method: :post, class: "devise-form" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div class="field">
        <%= f.label :email %>
        <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            placeholder: "Email" %>
      </div>
      <div class="actions">
        <%= f.submit "Send reset instructions" %>
      </div>
    <% end %>
    <%= render "devise/shared/links" %>
  </div>
</div>