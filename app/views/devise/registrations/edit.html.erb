<turbo-frame id="account-settings">
  <div class="profile-form">
    <h2>Account settings</h2>
    <%= form_for(resource,
        as: resource_name,
        url: registration_path(resource_name),
        html: {
          method: :put,
          class: "profile-form-content",
          data: { turbo_frame: "_top" }
        }) do |f| %>
      <div class="profile-field">
        <%= f.email_field :email,
            placeholder: "Email",
            class: "profile-name-input" %>
        <% resource.errors[:email].each do |error| %>
          <p class="field-error">
            Email <%= error %>
          </p>
        <% end %>
      </div>
      <div class="profile-field">
        <%= f.password_field :password,
            placeholder: "New password",
            class: "profile-name-input" %>
        <% resource.errors[:password].each do |error| %>
          <p class="field-error">
            Password <%= error %>
          </p>
        <% end %>
      </div>
      <div class="profile-field">
        <%= f.password_field :password_confirmation,
            placeholder: "Confirm new password",
            class: "profile-name-input" %>
        <% resource.errors[:password_confirmation].each do |error| %>
          <p class="field-error">
            Password confirmation <%= error %>
          </p>
        <% end %>
      </div>
      <div class="profile-field">
        <h3 class="password-hint">
          Please enter your password to save changes.
        </h3>
        <%= f.password_field :current_password,
            placeholder: "Current password",
            class: "profile-name-input" %>
        <% resource.errors[:current_password].each do |error| %>
          <p class="field-error">
            Current password <%= error %>
          </p>
        <% end %>
      </div>
      <div class="profile-form-actions">
        <%= f.submit "Save account",
            class: "profile-save-button" %>
      </div>
    <% end %>
    <h2>Delete account</h2>
    <%= button_to "Delete my account",
        registration_path(resource_name),
        method: :delete,
        data: {
          turbo_confirm: "Are you sure you want to delete your account?"
        },
        class: "delete-account-button" %>
  </div>
</turbo-frame>