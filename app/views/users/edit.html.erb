<main class="index-container edit-profile">
  <div class="profile-form">
    <h2>Edit profile</h2>
    <%= form_with model: @user, class: "profile-form-content" do |f| %>
      <div class="profile-avatar-upload" data-controller="avatar-preview">
        <div class="avatar-preview">
          <%= user_avatar( 
                @user, 
                class_name: "user-avatar", 
                data: { avatar_preview_target: "preview" } 
              ) %>
          <div class="avatar-upload-btn-container">
            <%= f.file_field :avatar, 
                class: "file-input", 
                id: "avatar-upload", 
                data: { action: "change->avatar-preview#show" } %>
            <label for="avatar-upload" class="avatar-upload-button">
              <%= image_tag "camera_plus.svg" %>
            </label>
          </div>
        </div>
        <% if @user.avatar.attached? %>
          <div class="avatar-actions">
            <%= button_tag "Delete profile picture", 
                type: "submit", 
                name: "remove_avatar", 
                value: "1", 
                class: "delete-avatar-button" %>
          </div>
        <% end %>
      </div>
      <% if @user.errors[:avatar].any? %>
        <div class="field-error">
          <%= @user.errors.full_messages_for(:avatar).first %>
        </div>
      <% end %>
      <%= f.text_field :name, 
          placeholder: "Name", 
          class: "profile-name-input" %>
      <% if @user.errors[:name].any? %>
        <div class="field-error">
          <%= @user.errors.full_messages_for(:name).first %>
        </div>
      <% end %>
      <%= f.text_area :bio, 
          placeholder: "Let people know who you are...", 
          class: "profile-bio-input" %>
      <% if @user.errors[:bio].any? %>
        <div class="field-error">
          <%= @user.errors.full_messages_for(:bio).first %>
        </div>
      <% end %>
      <div class="profile-form-actions">
        <%= f.submit "Save profile", 
            class: "profile-save-button" %>
      </div>
    <% end %>
  </div>
  <turbo-frame id="account-settings">
    <%= link_to "Account settings", 
        edit_user_registration_path, 
        data: { turbo_frame: "account-settings" } %>
  </turbo-frame>
</main>