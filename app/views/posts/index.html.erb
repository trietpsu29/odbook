<h1>Posts</h1>
<% @posts.each do |post| %>
  <div>
    <h3>
      <%= post.user.name %>
    </h3>
    <p>
      <%= post.body %>
    </p>
    <% if post.images.attached? %>
      <% post.images.each do |image| %>
        <%= image_tag image, width: 300 %>
      <% end %>
    <% end %>
    <hr>
  </div>
<% end %>