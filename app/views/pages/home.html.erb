<main class="landing-page">
  <div class="landing-container">
    <%= render "shared/brand" %>
    <%= render "shared/actions_side" do %>
      <div class="landing-actions">
        <div class="acc">
          <%= button_to "Log in",
              new_user_session_path,
              class: "btn",
              method: :get %>
          <%= button_to "Sign up",
              new_user_registration_path,
              class: "btn",
              method: :get %>
        </div>
        <div class="divider">
          <span>or</span>
        </div>
        <%= button_to user_google_oauth2_omniauth_authorize_path,
              method: :post,
              data: { turbo: false },
              class: "btn google-btn" do %>
          <%= image_tag "google-color.svg", alt: "" %>
          <span>Continue with Google</span>
        <% end %>
      </div>
    <% end %>
  </div>
</main>